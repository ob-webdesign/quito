# Vercel Blob Store — wird automatisch gesetzt, sobald im Vercel-Projekt
# unter "Storage" ein Blob-Store angelegt und mit diesem Projekt verknüpft wird.
# Lokal per `vercel env pull .env.local` holen.
BLOB_READ_WRITE_TOKEN=

# Admin-Passwort für den Foto-Upload in der Speisekarte (api/dish-auth.js).
# Frei wählbar, aber bitte ein echtes, nicht erratbares Passwort setzen —
# ersetzt das bisherige, im Client-Code sichtbare "quito2026".
DISH_ADMIN_PASSWORD=
