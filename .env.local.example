# Vercel Blob Store — Read/Write-Token des verbundenen Blob-Stores.
# Lokal per `vercel env pull .env.local` holen.
ADMIN_READ_WRITE_TOKEN=

# Admin-Passwort für den Foto-/Galerie-Upload (api/dish-auth.js, gemeinsam für
# Speisekarte und Galerie). Frei wählbar, aber bitte ein echtes, nicht
# erratbares Passwort setzen.
ADMIN_PASSWORD=
